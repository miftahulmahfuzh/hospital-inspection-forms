# Neon Postgres connection string. The Vercel/Neon integration sets DATABASE_URL;
# DATABASE_URL_UNPOOLED is accepted as a fallback for a directly pasted URL.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Admin login for /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs the admin session cookie. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string
